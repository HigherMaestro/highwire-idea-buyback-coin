{
  "name": "buyback-coin",
  "private": true,
  "type": "module",
  "description": "An agent that launches a coin, claims its creator fees every day, spends a share buying the coin back, and posts what it did on the coin's page.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "service": "node scripts/service.mjs",
    "setup": "node scripts/setup.mjs",
    "highwire": "node scripts/highwire.mjs",
    "orders": "node scripts/highwire.mjs orders run",
    "agent": "tsx src/agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highwire-agent": "0.18.0",
    "highwire-core": "0.18.0",
    "highwire-mcp": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
